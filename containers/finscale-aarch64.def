# Apptainer definition for FinScale on aarch64 (NVIDIA GB10 / Grace-Blackwell).
#
# Build (on an aarch64 host, or any host with an aarch64-capable builder):
#   apptainer build finscale-aarch64.sif containers/finscale-aarch64.def
#
# Verify the base image actually published an arm64 manifest before relying on it:
#   docker manifest inspect nvcr.io/nvidia/pytorch:24.10-py3 | grep -i arm64
# NGC publishes multi-arch manifests for recent pytorch/cuda tags, but not every tag has
# an arm64 variant — pick a tag you've confirmed, not necessarily the one below.
#
# Run (bind the repo and a cache dir):
#   apptainer run --nv \
#     --bind /workspace/FinscaleNvidiaPlatform:/workspace/FinscaleNvidiaPlatform \
#     --bind /workspace/.cache:/root/.cache \
#     finscale-aarch64.sif

Bootstrap: docker
From: nvcr.io/nvidia/pytorch:24.10-py3

%labels
    Project FinScale
    Arch aarch64
    Target NVIDIA GB10 (Grace-Blackwell)

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    python3 -m pip install --upgrade pip
    python3 -c 'import torch; assert torch.cuda.is_available() or True' # placeholder; real check happens at %runscript time
    # requirements-aarch64.txt is copied in by the build context (see %files below).
    python3 -m pip install -r /opt/finscale/requirements-aarch64.txt
    python3 -m pip check

%files
    requirements-aarch64.txt /opt/finscale/requirements-aarch64.txt

%environment
    export USE_TF=0
    export USE_FLAX=0
    export HF_HOME=/workspace/.cache/huggingface

%runscript
    nvidia-smi
    python3 -c 'import torch; assert torch.cuda.is_available(), "CUDA PyTorch is required"; \
        print("CUDA:", torch.version.cuda, "GPU:", torch.cuda.get_device_name(0))'
    exec "$@"
